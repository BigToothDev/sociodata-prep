{
  "compilerOptions": {
    "lib": ["es6"],
    "experimentalDecorators": true,
    "target": "ES6",
    "module": "commonjs",
    "declaration": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
